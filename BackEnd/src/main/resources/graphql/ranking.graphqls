type LeaderboardEntry {
    avatar: String
    rank: Int!
    userId: ID!
    displayName: String!
    "Số mục nội dung đã thuộc."
    score: Int!
    me: Boolean!
}

type Achievement {
    code: String!
    title: String!
    description: String!
    "Bậc hiện đạt được (0 = chưa mở khoá)."
    tier: Int!
    maxTier: Int!
    current: Int!
    nextTarget: Int!
}

enum LeaderboardPeriod {
    ALL
    WEEK
    "Chỉ bạn bè (người bạn theo dõi) và chính bạn."
    FRIENDS
}

extend type Query {
    "Bảng xếp hạng toàn thời gian (ALL), 7 ngày gần nhất (WEEK) hoặc chỉ bạn bè (FRIENDS)."
    leaderboard(limit: Int = 20, period: LeaderboardPeriod = ALL): [LeaderboardEntry!]!
    myRank(period: LeaderboardPeriod = ALL): LeaderboardEntry!
    achievements: [Achievement!]!
}
